# Gemini / AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Market Radar provider. Keep "mock" for local development.
# Set to "facebook" only when the server is configured with an authorized Facebook session.
MARKET_RADAR_PROVIDER="mock"

# Facebook Marketplace runtime configuration.
# NEVER commit real values and NEVER paste session credentials into source control or chat.
FACEBOOK_COOKIE_HEADER=""
FACEBOOK_FB_DTSG=""
FACEBOOK_LSD=""
FACEBOOK_JAZOEST=""
FACEBOOK_CLIENT_REVISION=""
FACEBOOK_SEARCH_DOC_ID=""
FACEBOOK_REQUESTS_PER_MINUTE="3"
