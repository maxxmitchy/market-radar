# Gemini / AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Market Radar provider.
# mock       = local demo data
# gemini-web = public web discovery using Gemini + Google Search grounding
# facebook   = experimental session-based adapter; not required for normal use
MARKET_RADAR_PROVIDER="mock"

# Gemini web discovery uses GEMINI_API_KEY above.
# Google Search grounding may incur Gemini API usage charges.

# Experimental Facebook Marketplace runtime. Keep blank unless you intentionally configure it.
# NEVER commit real values and NEVER paste session credentials into source control or chat.
FACEBOOK_COOKIE_HEADER=""
FACEBOOK_FB_DTSG=""
FACEBOOK_LSD=""
FACEBOOK_JAZOEST=""
FACEBOOK_CLIENT_REVISION=""
FACEBOOK_SEARCH_DOC_ID=""
FACEBOOK_REQUESTS_PER_MINUTE="3"
